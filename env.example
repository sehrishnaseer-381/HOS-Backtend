# Copy to .env for local dev. On Railway, set variables in the dashboard (no file).

# --- PostgreSQL (Railway: add Postgres plugin → DATABASE_URL is injected automatically) ---
# Railway often gives: postgresql://user:pass@host:port/railway
# This app rewrites that to postgresql+asyncpg://... automatically — you do NOT have to edit it.
# Local example:
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/hosdb

# --- SQLite (only if DATABASE_URL is unset — not for production on Railway) ---
# DATABASE_URL=sqlite+aiosqlite:///./hos_local.db

# Set to 0 to skip inserting two demo notifications when the table is empty
# HOS_SEED_NOTIFICATIONS=1

# CORS: default in code is "*" (all origins).
# Optional lock-down: CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Railway checklist:
# 1) Service "Root Directory" = backend (if your Git repo root is HOS-app or parent).
# 2) Add PostgreSQL resource and link it to this service (DATABASE_URL appears in Variables).
# 3) Start command: uvicorn main:app --host 0.0.0.0 --port $PORT (see railway.toml / Procfile).
# 4) After deploy: open /docs, try GET /api/db-check — ok:true and backend:postgres means DB works.
