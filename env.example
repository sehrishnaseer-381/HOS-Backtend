# Copy to .env and adjust. Uvicorn reads this when started from the backend folder.

# --- PostgreSQL (recommended for production / team setups) ---
# Use async driver asyncpg. Create database first: createdb hosdb (or use pgAdmin).
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/hosdb

# --- SQLite (default if DATABASE_URL is unset; good for local dev) ---
# DATABASE_URL=sqlite+aiosqlite:///./hos_local.db

# Set to 0 to skip inserting two demo notifications when the table is empty
# HOS_SEED_NOTIFICATIONS=1

# CORS: default in code is "*" (all origins) so Vercel can call this API.
# To lock down: CORS_ALLOW_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# (remove CORS_ORIGIN_REGEX if you added it on Railway — older examples used it)
